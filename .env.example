LOCAL_RAG_SOURCE_REGISTRY=/config/source-registry.local.example.yaml
LOCAL_RAG_CONFIG_DIR=./config
LOCAL_RAG_DATA_DIR=./.runtime
LOCAL_RAG_POSTGRES_PASSWORD=local-rag-dev
LOCAL_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_RAG_OLLAMA_BASE_URLS=http://host.docker.internal:11434
LOCAL_RAG_OLLAMA_CONNECT_TIMEOUT_MILLIS=1500
LOCAL_RAG_OLLAMA_READ_TIMEOUT_MILLIS=120000
LOCAL_RAG_EMBEDDING_MODEL=qwen3-embedding:4b
LOCAL_RAG_CHAT_MODEL=qwen3.5:4b
LOCAL_RAG_OMLX_BASE_URL=
LOCAL_RAG_EMBEDDING_FALLBACK_ENABLED=false
LOCAL_RAG_RERANKER_ENABLED=false
LOCAL_RAG_RERANKER_BASE_URL=http://reranker-sidecar:42145
LOCAL_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_RAG_RERANKER_MAX_LENGTH=1024
LOCAL_RAG_RERANKER_USE_FP16=false
LOCAL_RAG_RERANKER_CONNECT_TIMEOUT_MILLIS=500
LOCAL_RAG_RERANKER_READ_TIMEOUT_MILLIS=5000
LOCAL_RAG_SCOREGATE_ENABLED=false
LOCAL_RAG_SCOREGATE_MAX_K=10
LOCAL_RAG_SCOREGATE_SIMILARITY_THRESHOLD=0.70
LOCAL_RAG_SCOREGATE_RERANKER_THRESHOLD=0.08
LOCAL_RAG_SCOREGATE_SIMILARITY_WEIGHT=0.30
LOCAL_RAG_SCOREGATE_BUCKET2_THRESHOLD=0.255
LOCAL_RAG_SCOREGATE_BUCKET3_THRESHOLD=0.15
LOCAL_RAG_SCAN_INTERVAL_SECONDS=300
LOCAL_RAG_WATCH_ENABLED=true
LOCAL_RAG_WATCH_DEBOUNCE_SECONDS=10

LOCAL_RAG_SOURCE_ROOT=./data/sample
LOCAL_RAG_SOURCE_PERSONAL_NOTES=/source/personal-notes
LOCAL_RAG_SOURCE_PROJECT_ALPHA_DOCS=/source/project-alpha-docs
LOCAL_RAG_SOURCE_PROJECT_BETA_DOCS=/source/project-beta-docs
LOCAL_RAG_SOURCE_LOCAL_RAG_SYSTEM_DOCS=/sources/source-04
LOCAL_RAG_SOURCE_EXTRA_06=/sources/source-06
LOCAL_RAG_SOURCE_EXTRA_07=/sources/source-07
LOCAL_RAG_SOURCE_EXTRA_08=/sources/source-08
LOCAL_RAG_HOST_SOURCE_01=./data/sample/project-alpha-docs
LOCAL_RAG_HOST_SOURCE_02=./data/sample/project-beta-docs
LOCAL_RAG_HOST_SOURCE_03=./data/sample/personal-notes
LOCAL_RAG_HOST_SOURCE_04=./docs
LOCAL_RAG_HOST_SOURCE_05=./data/sample/personal-notes
LOCAL_RAG_HOST_SOURCE_06=./data/sample/project-alpha-docs
LOCAL_RAG_HOST_SOURCE_07=./data/sample/project-beta-docs
LOCAL_RAG_HOST_SOURCE_08=./data/sample/personal-notes
