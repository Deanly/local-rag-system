LOCAL_RAG_REGISTRY_PATH=/config/source-registry.local.example.yaml
LOCAL_RAG_REGISTRY_REQUIRE_PATHS=true
LOCAL_RAG_CONFIG_DIR=./config
LOCAL_RAG_DATA_DIR=./.runtime
LOCAL_RAG_POSTGRES_PASSWORD=local-rag-dev
LOCAL_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_RAG_OLLAMA_BASE_URLS=http://host.docker.internal:11434
LOCAL_RAG_OLLAMA_CONNECT_TIMEOUT=PT1.5S
LOCAL_RAG_OLLAMA_READ_TIMEOUT=PT2M
LOCAL_RAG_OLLAMA_HEALTH_TIMEOUT=PT1.5S
LOCAL_RAG_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
LOCAL_RAG_OLLAMA_CHAT_MODEL=qwen3.5:4b
LOCAL_RAG_OLLAMA_CHAT_MAX_TOKENS=512
LOCAL_RAG_OLLAMA_CHAT_TEMPERATURE=0.1
LOCAL_RAG_OLLAMA_CHAT_THINKING_ENABLED=false
LOCAL_RAG_INDEXER_EMBEDDING_FALLBACK_ENABLED=false
LOCAL_RAG_INDEXER_SCAN_INTERVAL=PT5M
LOCAL_RAG_INDEXER_WATCH_ENABLED=true
LOCAL_RAG_INDEXER_WATCH_DEBOUNCE=PT10S
LOCAL_RAG_RETRIEVAL_EMBEDDING_FALLBACK_ENABLED=false
LOCAL_RAG_RETRIEVAL_RERANKER_ENABLED=false
LOCAL_RAG_RETRIEVAL_RERANKER_BASE_URL=http://reranker-sidecar:42145
LOCAL_RAG_RETRIEVAL_RERANKER_CONNECT_TIMEOUT=PT0.5S
LOCAL_RAG_RETRIEVAL_RERANKER_READ_TIMEOUT=PT5S
LOCAL_RAG_RETRIEVAL_SCORE_GATE_ENABLED=false
LOCAL_RAG_RETRIEVAL_SCORE_GATE_MAX_K=10
LOCAL_RAG_RETRIEVAL_SCORE_GATE_SIMILARITY_THRESHOLD=0.70
LOCAL_RAG_RETRIEVAL_SCORE_GATE_RERANKER_THRESHOLD=0.08
LOCAL_RAG_RETRIEVAL_SCORE_GATE_SIMILARITY_WEIGHT=0.30
LOCAL_RAG_RETRIEVAL_SCORE_GATE_BUCKET2_THRESHOLD=0.255
LOCAL_RAG_RETRIEVAL_SCORE_GATE_BUCKET3_THRESHOLD=0.15
LOCAL_RAG_WEAVIATE_URL=http://weaviate:8080
LOCAL_RAG_SERVICES_REGISTRY_URL=http://source-registry-service:42141
LOCAL_RAG_SERVICES_INDEXER_URL=http://indexer-service:42142
LOCAL_RAG_SERVICES_RETRIEVAL_URL=http://retrieval-service:42143
LOCAL_RAG_SERVICES_MCP_BRIDGE_URL=http://mcp-bridge:42144

# Host-only settings consumed by `local-rag install-ollama-launchagent`.
LOCAL_RAG_OLLAMA_BIN=
LOCAL_RAG_OLLAMA_LAUNCH_AGENT_HOST=127.0.0.1:11434
LOCAL_RAG_OLLAMA_LAUNCH_AGENT_LABEL=com.localrag.ollama
LOCAL_RAG_LAUNCH_AGENTS_DIR=

# Optional reranker sidecar process settings.
LOCAL_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_RAG_RERANKER_MAX_LENGTH=1024
LOCAL_RAG_RERANKER_USE_FP16=false

LOCAL_RAG_SOURCE_ROOT=./data/sample
LOCAL_RAG_SOURCE_PERSONAL_NOTES=/source/personal-notes
LOCAL_RAG_SOURCE_PROJECT_ALPHA_DOCS=/source/project-alpha-docs
LOCAL_RAG_SOURCE_PROJECT_BETA_DOCS=/source/project-beta-docs
LOCAL_RAG_SOURCE_LOCAL_RAG_SYSTEM_DOCS=/sources/source-04
LOCAL_RAG_SOURCE_EXTRA_06=/sources/source-06
LOCAL_RAG_SOURCE_EXTRA_07=/sources/source-07
LOCAL_RAG_SOURCE_EXTRA_08=/sources/source-08
LOCAL_RAG_HOST_SOURCE_01=./data/sample/project-alpha-docs
LOCAL_RAG_HOST_SOURCE_02=./data/sample/project-beta-docs
LOCAL_RAG_HOST_SOURCE_03=./data/sample/personal-notes
LOCAL_RAG_HOST_SOURCE_04=./docs
LOCAL_RAG_HOST_SOURCE_05=./data/sample/personal-notes
LOCAL_RAG_HOST_SOURCE_06=./data/sample/project-alpha-docs
LOCAL_RAG_HOST_SOURCE_07=./data/sample/project-beta-docs
LOCAL_RAG_HOST_SOURCE_08=./data/sample/personal-notes
