# Source-only candidate profile for the M4 three-zone policy proxy.
# Keep the .invalid endpoint and placeholder host paths in version control.
# Real LAN endpoints and token paths belong only in the Service-zone env.

LOCAL_RAG_QUERY_EMBEDDING_BASE_URLS=http://m4-ollama-proxy.invalid:11434
LOCAL_RAG_QUERY_EMBEDDING_REQUEST_MODEL=silverstone/rag-query:qwen3-4b-v2
LOCAL_RAG_QUERY_EMBEDDING_PROVENANCE_MODEL=qwen3-embedding:4b
LOCAL_RAG_QUERY_EMBEDDING_BINDING_ID=rag-query-qwen3-v2
LOCAL_RAG_QUERY_BINDING_TOKEN_FILE=/run/secrets/rag-query-qwen3-v2.token
LOCAL_RAG_QUERY_BINDING_TOKEN_HOST_FILE=/path/to/private/rag-query-qwen3-v2.token
LOCAL_RAG_QUERY_BINDING_AUTHENTICATION_REQUIRED=true
LOCAL_RAG_QUERY_EMBEDDING_EXPECTED_DIMENSIONS=2560
LOCAL_RAG_QUERY_EMBEDDING_KEEP_ALIVE_SECONDS=120

LOCAL_RAG_BULK_EMBEDDING_BASE_URLS=http://m4-ollama-proxy.invalid:11434
LOCAL_RAG_BULK_EMBEDDING_REQUEST_MODEL=silverstone/rag-bulk:qwen3-4b-v2
LOCAL_RAG_BULK_EMBEDDING_PROVENANCE_MODEL=qwen3-embedding:4b
LOCAL_RAG_BULK_EMBEDDING_BINDING_ID=rag-bulk-qwen3-v2
LOCAL_RAG_BULK_BINDING_TOKEN_FILE=/run/secrets/rag-bulk-qwen3-v2.token
LOCAL_RAG_BULK_BINDING_TOKEN_HOST_FILE=/path/to/private/rag-bulk-qwen3-v2.token
LOCAL_RAG_BULK_BINDING_AUTHENTICATION_REQUIRED=true
LOCAL_RAG_BULK_EMBEDDING_EXPECTED_DIMENSIONS=2560
LOCAL_RAG_BULK_EMBEDDING_KEEP_ALIVE_SECONDS=0
