#!/usr/bin/env bash
set -euo pipefail

BOOTSTRAP_ENV="${LOCAL_RAG_BOOTSTRAP_ENV:-${XDG_CONFIG_HOME:-${HOME}/.config}/local-rag-system/operator.env}"
if [[ -f "${BOOTSTRAP_ENV}" ]]; then
  # shellcheck disable=SC1090
  source "${BOOTSTRAP_ENV}"
fi

SERVICE_ROOT="${LOCAL_RAG_SERVICE_ROOT:-${XDG_DATA_HOME:-${HOME}/.local/share}/local-rag-system}"
CODE_DIR="${LOCAL_RAG_CODE_DIR:-${SERVICE_ROOT}/code/local-rag-system}"
REPO_URL="${LOCAL_RAG_REPO_URL:-https://github.com/Deanly/local-rag-system.git}"
CONFIG_DIR="${LOCAL_RAG_CONFIG_DIR:-${SERVICE_ROOT}/config/local-rag-system}"
ENV_FILE="${LOCAL_RAG_ENV_FILE:-${CONFIG_DIR}/local.env}"
BASE_URL="${LOCAL_RAG_BASE_URL:-http://127.0.0.1:42120}"
BIN_DIR="${LOCAL_RAG_BIN_DIR:-${SERVICE_ROOT}/bin}"
SOURCE_CHECKOUT_FILE="${CONFIG_DIR}/source-checkout.path"

usage() {
  cat <<'USAGE'
Usage: local-rag <command> [args]

Commands:
  config              Print operational paths.
  install-command     Install this command under LOCAL_RAG_BIN_DIR.
  install-ollama-launchagent
                       Render and load the macOS Ollama LaunchAgent from local settings.
  init-dirs           Create Service directories.
  init-config         Create an operational checkout and sample local config.
  sync-local [path]   Copy a local checkout into the operational code dir.
  doctor              Check local prerequisites and operational files.
  pull                Clone/pull the configured repo, or sync a configured local checkout.
  deploy              Pull code, start stack, and install Codex integration.
  update              Refresh code, rebuild/restart stack, and install Codex integration.
  start               Start the Docker Compose stack without rebuilding.
  run                 Alias for start.
  up                  Start/rebuild the Docker Compose stack.
  rebuild             Rebuild/recreate the Docker Compose stack.
  down                Stop the Docker Compose stack without deleting data.
  stop                Alias for down.
  restart             Recreate the Docker Compose stack.
  status              Show compose ps, health, and index status.
  health              Show gateway health.
  index-status        Show index status.
  force-scan [project] Force scan all sources or one project id.
  logs [service...]   Show recent compose logs.
  install-codex       Install global Codex MCP/skill integration.
  codex-smoke [args]  Run Codex MCP adapter and REST smoke checks.

Environment:
  LOCAL_RAG_BOOTSTRAP_ENV optional machine-local operator bootstrap env
  LOCAL_RAG_SERVICE_ROOT defaults under XDG_DATA_HOME (or ~/.local/share)
  LOCAL_RAG_CODE_DIR     defaults under LOCAL_RAG_SERVICE_ROOT
  LOCAL_RAG_CONFIG_DIR   defaults under LOCAL_RAG_SERVICE_ROOT
  LOCAL_RAG_ENV_FILE     defaults under LOCAL_RAG_CONFIG_DIR
  LOCAL_RAG_REPO_URL     default: https://github.com/Deanly/local-rag-system.git
  LOCAL_RAG_BASE_URL     default: http://127.0.0.1:42120
  LOCAL_RAG_SOURCE_CHECKOUT optional local checkout to sync instead of git pull
  BRANCH                 Git branch used for main-latest deploys; default: main
  DEPLOY_VERSION         Optional tag to deploy, usually set by deploy authority

Optional operation-zone files:
  LOCAL_RAG_CONFIG_DIR/docker-compose.override.yaml
                         read automatically when present
USAGE
}

init_dirs() {
  mkdir -p "${CODE_DIR}" "${CONFIG_DIR}" "${SERVICE_ROOT}/runtime/local-rag-system" "${SERVICE_ROOT}/logs/local-rag-system" "${BIN_DIR}"
}

code_ready() {
  [[ -f "${CODE_DIR}/docker-compose.yml" && -f "${CODE_DIR}/pom.xml" ]]
}

resolve_source_checkout() {
  if [[ -n "${LOCAL_RAG_SOURCE_CHECKOUT:-}" ]]; then
    printf '%s\n' "${LOCAL_RAG_SOURCE_CHECKOUT}"
  elif [[ -f "${SOURCE_CHECKOUT_FILE}" ]]; then
    sed -n '1p' "${SOURCE_CHECKOUT_FILE}"
  fi
}

trim() {
  local value="${1:-}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

reset_git_checkout() {
  local deploy_version branch ref label
  deploy_version="$(trim "${DEPLOY_VERSION:-${DEPLOY_TAG:-}}")"
  branch="$(trim "${BRANCH:-main}")"

  git -C "${CODE_DIR}" fetch --all --prune --tags
  if [[ -n "${deploy_version}" ]]; then
    if ! git -C "${CODE_DIR}" rev-parse -q --verify "refs/tags/${deploy_version}^{commit}" >/dev/null; then
      echo "Deploy tag not found: ${deploy_version}" >&2
      exit 66
    fi
    ref="refs/tags/${deploy_version}^{commit}"
    label="tag ${deploy_version}"
  else
    if [[ -z "${branch}" ]]; then
      echo "Missing deploy branch." >&2
      exit 66
    fi
    if ! git -C "${CODE_DIR}" rev-parse -q --verify "refs/remotes/origin/${branch}^{commit}" >/dev/null; then
      echo "Deploy branch not found: origin/${branch}" >&2
      exit 66
    fi
    ref="origin/${branch}"
    label="origin/${branch}"
  fi

  echo "Resetting ${CODE_DIR} to ${label}"
  git -C "${CODE_DIR}" reset --hard "${ref}"
  git -C "${CODE_DIR}" clean -fdx
}

sync_code_from_checkout() {
  local source_checkout="$1"
  if [[ -z "${source_checkout}" ]]; then
    echo "Missing local checkout path." >&2
    exit 1
  fi
  if [[ ! -f "${source_checkout}/docker-compose.yml" || ! -f "${source_checkout}/pom.xml" ]]; then
    echo "Not a local-rag-system checkout: ${source_checkout}" >&2
    exit 1
  fi
  if ! command -v rsync >/dev/null 2>&1; then
    echo "rsync is required for sync-local" >&2
    exit 1
  fi
  init_dirs
  rsync -a --delete \
    --exclude='.git/' \
    --exclude='.runtime/' \
    --exclude='target/' \
    --exclude='*/target/' \
    --exclude='.env' \
    --exclude='config/*.local.yaml' \
    "${source_checkout%/}/" "${CODE_DIR}/"
  printf '%s\n' "${source_checkout}" > "${SOURCE_CHECKOUT_FILE}"
  echo "Synced local checkout into ${CODE_DIR}"
}

install_command() {
  init_dirs
  if [[ -e "${BIN_DIR}/local-rag" && "$0" -ef "${BIN_DIR}/local-rag" ]]; then
    echo "Command already installed: ${BIN_DIR}/local-rag"
    return
  fi
  install -m 0755 "$0" "${BIN_DIR}/local-rag"
  echo "Installed command: ${BIN_DIR}/local-rag"
}

ensure_code() {
  init_dirs
  local source_checkout
  source_checkout="$(resolve_source_checkout || true)"
  if [[ -n "${source_checkout}" ]]; then
    sync_code_from_checkout "${source_checkout}"
  elif [[ ! -d "${CODE_DIR}/.git" ]]; then
    if [[ -e "${CODE_DIR}" && -n "$(find "${CODE_DIR}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
      if code_ready; then
        echo "Using existing operational code snapshot: ${CODE_DIR}"
        return
      else
        echo "Code directory exists and is not a usable checkout: ${CODE_DIR}" >&2
        exit 1
      fi
    fi
    git clone "${REPO_URL}" "${CODE_DIR}"
    reset_git_checkout
  else
    reset_git_checkout
  fi
}

require_code() {
  if ! code_ready; then
    echo "Missing operational code: ${CODE_DIR}. Run: local-rag pull or local-rag sync-local /path/to/checkout" >&2
    exit 1
  fi
}

require_env() {
  if [[ ! -f "${ENV_FILE}" ]]; then
    echo "Missing env file: ${ENV_FILE}. Run: local-rag init-config" >&2
    exit 1
  fi
}

init_config() {
  ensure_code
  mkdir -p "${CONFIG_DIR}" "${SERVICE_ROOT}/runtime"

  if [[ ! -f "${CONFIG_DIR}/source-registry.local.yaml" ]]; then
    cp "${CODE_DIR}/config/source-registry.local.example.yaml" "${CONFIG_DIR}/source-registry.local.yaml"
  fi

  if [[ ! -f "${ENV_FILE}" ]]; then
    cat > "${ENV_FILE}" <<EOF
LOCAL_RAG_REGISTRY_PATH=/config/source-registry.local.yaml
LOCAL_RAG_REGISTRY_REQUIRE_PATHS=true
LOCAL_RAG_CONFIG_DIR=${CONFIG_DIR}
LOCAL_RAG_DATA_DIR=${SERVICE_ROOT}/runtime/local-rag-system
LOCAL_RAG_POSTGRES_PASSWORD=local-rag-dev
LOCAL_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_RAG_OLLAMA_BASE_URLS=http://host.docker.internal:11434
LOCAL_RAG_OLLAMA_CONNECT_TIMEOUT=PT1.5S
LOCAL_RAG_OLLAMA_READ_TIMEOUT=PT2M
LOCAL_RAG_OLLAMA_HEALTH_TIMEOUT=PT1.5S
LOCAL_RAG_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
LOCAL_RAG_OLLAMA_CHAT_MODEL=qwen3.5:4b
LOCAL_RAG_OLLAMA_CHAT_MAX_TOKENS=512
LOCAL_RAG_OLLAMA_CHAT_TEMPERATURE=0.1
LOCAL_RAG_OLLAMA_CHAT_THINKING_ENABLED=false
LOCAL_RAG_INDEXER_EMBEDDING_FALLBACK_ENABLED=false
LOCAL_RAG_INDEXER_SCAN_INTERVAL=PT5M
LOCAL_RAG_INDEXER_WATCH_ENABLED=true
LOCAL_RAG_INDEXER_WATCH_DEBOUNCE=PT10S
LOCAL_RAG_RETRIEVAL_EMBEDDING_FALLBACK_ENABLED=false
LOCAL_RAG_OLLAMA_BIN=
LOCAL_RAG_OLLAMA_LAUNCH_AGENT_HOST=127.0.0.1:11434
LOCAL_RAG_OLLAMA_LAUNCH_AGENT_LABEL=com.localrag.ollama
LOCAL_RAG_LAUNCH_AGENTS_DIR=
LOCAL_RAG_DEFAULT_PROJECT_ID=local-rag-system
LOCAL_RAG_SOURCE_ROOT=${CODE_DIR}/data/sample
LOCAL_RAG_SOURCE_PERSONAL_NOTES=/source/personal-notes
LOCAL_RAG_SOURCE_PROJECT_ALPHA_DOCS=/source/project-alpha-docs
LOCAL_RAG_SOURCE_PROJECT_BETA_DOCS=/source/project-beta-docs
LOCAL_RAG_SOURCE_LOCAL_RAG_SYSTEM_DOCS=/sources/source-04
LOCAL_RAG_SOURCE_EXTRA_06=/sources/source-06
LOCAL_RAG_SOURCE_EXTRA_07=/sources/source-07
LOCAL_RAG_SOURCE_EXTRA_08=/sources/source-08
LOCAL_RAG_HOST_SOURCE_01=${CODE_DIR}/data/sample/project-alpha-docs
LOCAL_RAG_HOST_SOURCE_02=${CODE_DIR}/data/sample/project-beta-docs
LOCAL_RAG_HOST_SOURCE_03=${CODE_DIR}/data/sample/personal-notes
LOCAL_RAG_HOST_SOURCE_04=${CODE_DIR}/docs
LOCAL_RAG_HOST_SOURCE_05=${CODE_DIR}/data/sample/personal-notes
LOCAL_RAG_HOST_SOURCE_06=${CODE_DIR}/data/sample/project-alpha-docs
LOCAL_RAG_HOST_SOURCE_07=${CODE_DIR}/data/sample/project-beta-docs
LOCAL_RAG_HOST_SOURCE_08=${CODE_DIR}/data/sample/personal-notes
EOF
  fi

  echo "Config file: ${ENV_FILE}"
  echo "Registry file: ${CONFIG_DIR}/source-registry.local.yaml"
  echo "Edit both files before indexing real source folders."
}

doctor() {
  local failed=0

  for executable in git docker curl; do
    if ! command -v "${executable}" >/dev/null 2>&1; then
      echo "missing command: ${executable}" >&2
      failed=1
    fi
  done

  if ! docker compose version >/dev/null 2>&1; then
    echo "docker compose is not available" >&2
    failed=1
  fi

  if ! command -v node >/dev/null 2>&1; then
    echo "node is not available; Codex MCP install will require LOCAL_RAG_NODE_BIN" >&2
    failed=1
  fi

  if ! code_ready; then
    echo "missing operational code: ${CODE_DIR}" >&2
    failed=1
  fi

  if [[ ! -f "${ENV_FILE}" ]]; then
    echo "missing env file: ${ENV_FILE}" >&2
    failed=1
  fi

  if [[ ! -f "${CONFIG_DIR}/source-registry.local.yaml" ]]; then
    echo "missing registry file: ${CONFIG_DIR}/source-registry.local.yaml" >&2
    failed=1
  fi

  if [[ "${failed}" == "0" ]]; then
    echo "local-rag prerequisites look ready."
    local source_checkout
    source_checkout="$(resolve_source_checkout || true)"
    if [[ -n "${source_checkout}" ]]; then
      echo "source checkout: ${source_checkout}"
    fi
    if [[ -f "${CONFIG_DIR}/docker-compose.override.yaml" ]]; then
      echo "compose override: ${CONFIG_DIR}/docker-compose.override.yaml"
    fi
    if [[ -x "${CODE_DIR}/integrations/codex/smoke-local-rag.mjs" ]]; then
      env LOCAL_RAG_BASE_URL="${BASE_URL}" node "${CODE_DIR}/integrations/codex/smoke-local-rag.mjs" --adapter-only
    fi
  fi
  return "${failed}"
}

load_local_env() {
  require_env
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
}

xml_escape() {
  local value="$1"
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  printf '%s' "${value}"
}

install_ollama_launchagent() {
  require_code
  load_local_env
  init_dirs

  local template label ollama_bin ollama_host launch_agents_dir stdout_path stderr_path working_directory target rendered
  template="${CODE_DIR}/ops/launchagents/com.localrag.ollama.plist.template"
  label="${LOCAL_RAG_OLLAMA_LAUNCH_AGENT_LABEL:?Set LOCAL_RAG_OLLAMA_LAUNCH_AGENT_LABEL in the local env}"
  ollama_bin="${LOCAL_RAG_OLLAMA_BIN:-$(command -v ollama || true)}"
  ollama_host="${LOCAL_RAG_OLLAMA_LAUNCH_AGENT_HOST:?Set LOCAL_RAG_OLLAMA_LAUNCH_AGENT_HOST in the local env}"
  launch_agents_dir="${LOCAL_RAG_LAUNCH_AGENTS_DIR:-${HOME}/Library/LaunchAgents}"
  stdout_path="${LOCAL_RAG_OLLAMA_LAUNCH_AGENT_STDOUT:-${SERVICE_ROOT}/logs/local-rag-system/ollama.log}"
  stderr_path="${LOCAL_RAG_OLLAMA_LAUNCH_AGENT_STDERR:-${SERVICE_ROOT}/logs/local-rag-system/ollama.err}"
  working_directory="${LOCAL_RAG_OLLAMA_WORKING_DIRECTORY:-${SERVICE_ROOT}/runtime/local-rag-system}"
  target="${launch_agents_dir}/${label}.plist"

  if [[ -z "${ollama_bin}" || ! -x "${ollama_bin}" ]]; then
    echo "Set LOCAL_RAG_OLLAMA_BIN to an executable Ollama binary" >&2
    exit 66
  fi
  if [[ ! -f "${template}" ]]; then
    echo "Missing LaunchAgent template: ${template}" >&2
    exit 66
  fi

  mkdir -p "${launch_agents_dir}" "$(dirname "${stdout_path}")" "$(dirname "${stderr_path}")" "${working_directory}"
  rendered="$(<"${template}")"
  rendered="${rendered//@@LABEL@@/$(xml_escape "${label}")}"
  rendered="${rendered//@@OLLAMA_BIN@@/$(xml_escape "${ollama_bin}")}"
  rendered="${rendered//@@OLLAMA_HOST@@/$(xml_escape "${ollama_host}")}"
  rendered="${rendered//@@STDOUT_PATH@@/$(xml_escape "${stdout_path}")}"
  rendered="${rendered//@@STDERR_PATH@@/$(xml_escape "${stderr_path}")}"
  rendered="${rendered//@@WORKING_DIRECTORY@@/$(xml_escape "${working_directory}")}"
  printf '%s\n' "${rendered}" > "${target}"
  plutil -lint "${target}"
  launchctl bootout "gui/$(id -u)/${label}" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "${target}"
  launchctl print "gui/$(id -u)/${label}"
}

install_codex_integration() {
  require_code
  load_local_env
  if [[ -f "${CONFIG_DIR}/codex-skill.local.md" ]]; then
    env LOCAL_RAG_BASE_URL="${BASE_URL}" \
      LOCAL_RAG_SKILL_FILE="${CONFIG_DIR}/codex-skill.local.md" \
      "${CODE_DIR}/integrations/codex/install-codex-local-rag.sh"
  else
    env LOCAL_RAG_BASE_URL="${BASE_URL}" \
      "${CODE_DIR}/integrations/codex/install-codex-local-rag.sh"
  fi
}

compose() {
  require_code
  require_env
  local compose_args=(-f docker-compose.yml)
  if [[ -f "${CONFIG_DIR}/docker-compose.override.yaml" ]]; then
    compose_args+=(-f "${CONFIG_DIR}/docker-compose.override.yaml")
  fi
  (cd "${CODE_DIR}" && docker compose --env-file "${ENV_FILE}" "${compose_args[@]}" "$@")
}

curl_json() {
  curl -fsS "$@"
}

command="${1:-}"
shift || true

case "${command}" in
  ""|help|--help|-h)
    usage
    ;;
  config)
    printf 'SERVICE_ROOT=%s\n' "${SERVICE_ROOT}"
    printf 'CODE_DIR=%s\n' "${CODE_DIR}"
    printf 'CONFIG_DIR=%s\n' "${CONFIG_DIR}"
    printf 'ENV_FILE=%s\n' "${ENV_FILE}"
    printf 'BIN_DIR=%s\n' "${BIN_DIR}"
    printf 'BASE_URL=%s\n' "${BASE_URL}"
    if [[ -f "${SOURCE_CHECKOUT_FILE}" ]]; then
      printf 'SOURCE_CHECKOUT=%s\n' "$(sed -n '1p' "${SOURCE_CHECKOUT_FILE}")"
    fi
    ;;
  install-command)
    install_command
    ;;
  install-ollama-launchagent)
    install_ollama_launchagent
    ;;
  init-dirs)
    init_dirs
    ;;
  init-config)
    init_config
    ;;
  sync-local)
    sync_code_from_checkout "${1:-$(pwd)}"
    ;;
  doctor)
    doctor
    ;;
  pull)
    ensure_code
    ;;
  start|run)
    compose up -d
    ;;
  up)
    compose up -d --build
    ;;
  rebuild|restart)
    compose up -d --build --force-recreate
    ;;
  down|stop)
    compose down
    ;;
  deploy|update)
    ensure_code
    if [[ ! -f "${ENV_FILE}" ]]; then
      init_config
    fi
    compose up -d --build
    install_codex_integration
    ;;
  status)
    compose ps
    echo
    curl_json "${BASE_URL}/api/health"
    echo
    curl_json "${BASE_URL}/api/index/status"
    echo
    ;;
  health)
    curl_json "${BASE_URL}/api/health"
    echo
    ;;
  index-status)
    curl_json "${BASE_URL}/api/index/status"
    echo
    ;;
  force-scan)
    if [[ "${1:-}" == "" ]]; then
      curl_json -X POST "${BASE_URL}/api/index/force"
    else
      curl_json -X POST "${BASE_URL}/api/index/force?projectId=$1"
    fi
    echo
    ;;
  logs)
    compose logs --no-color --tail="${LOCAL_RAG_LOG_TAIL:-200}" "$@"
    ;;
  install-codex)
    install_codex_integration
    ;;
  codex-smoke)
    require_code
    load_local_env
    export LOCAL_RAG_SMOKE_PROJECT_ID="${LOCAL_RAG_SMOKE_PROJECT_ID:-${LOCAL_RAG_DEFAULT_PROJECT_ID:-}}"
    env LOCAL_RAG_BASE_URL="${BASE_URL}" node "${CODE_DIR}/integrations/codex/smoke-local-rag.mjs" "$@"
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 1
    ;;
esac
